{
    "name": "s2j/inquiry-destination-service",
    "description": "Inquiry SaaS Adapter (WP-Independent)",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Koutarou ISHIKAWA",
            "email": "stein2nd@gmail.com"
        }
    ],
    "homepage": "https://github.com/stein2nd/s2j-inquiry-destination-service",
    "support": {
        "issues": "https://github.com/stein2nd/s2j-inquiry-destination-service/issues",
        "source": "https://github.com/stein2nd/s2j-inquiry-destination-service"
    },
    "autoload": {
        "psr-4": {
            "S2J\\InquiryDestinationService\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "S2J\\InquiryDestinationService\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "archive": {
        "name": "s2j-inquiry-destination-service",
        "exclude": [
            "/node_modules",
            "/vendor",
            "/wordpress",
            "/tests",
            "/docs",
            "/docs_mod",
            "/docs_old",
            "/.github",
            "/.vscode",
            "/.cursor",
            "/packages",
            "/scripts",
            "/schema",
            "/tools",
            "/examples",
            "/artifacts",
            "/dist",
            "/tmp",
            "/.sandbox",
            ".phpunit.cache",
            ".phpunit.result.cache",
            "phpunit.xml",
            "phpcs.xml.dist",
            "phpstan.neon",
            "package.json",
            "package-lock.json",
            ".textlintrc.json",
            "composer.lock",
            ".DS_Store",
            ".gitignore"
        ]
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "phpstan": "@php vendor/bin/phpstan analyse --memory-limit=512M",
        "phpcs": "@php vendor/bin/phpcs",
        "phpcbf": "@php vendor/bin/phpcbf",
        "lint:php": [
            "@phpstan",
            "@phpcs"
        ],
        "validate-composer": "composer validate --strict",
        "verify-dist": "bash scripts/verify-composer-dist.sh"
    },
    "config": {
        "sort-packages": true
    }
}
